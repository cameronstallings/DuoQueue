# --- Supabase (apps/mobile/.env, EXPO_PUBLIC_ prefix required for client-side vars) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...), Project Settings > API Keys. The name is the old
# one because apps/mobile/src/lib/supabase.ts reads it; the legacy anon key also works here
# until the legacy keys are switched off.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Supabase server-side (scripts only, NEVER prefix with EXPO_PUBLIC_) ---
# Deployed Edge Functions do not read these: the platform injects SUPABASE_URL,
# SUPABASE_SECRET_KEYS and SUPABASE_PUBLISHABLE_KEYS (JSON maps keyed by name, 'default')
# plus the legacy SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY, and
# supabase/functions/_shared/supabase-keys.ts picks the new key first.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...), Project Settings > API Keys. The variable keeps its old
# name for scripts/waitlist.mjs, seed-review-demo.mjs and generate-fake-profiles.ts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key
SUPABASE_DB_PASSWORD=your-db-password

# --- Sign in with Apple / Google (native auth) ---
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (Phase 4) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# --- Internal Edge Functions (Phase 5): shared secret for Postgres-trigger and
# scheduler calls to send-push-notification / daily-swipes-refreshed. Also goes into
# the `internal_trigger_token` row of the app_config table — see README setup step 5.
INTERNAL_TRIGGER_AUTH_TOKEN=

# --- Expo / EAS ---
EXPO_PUBLIC_APP_ENV=development
EAS_PROJECT_ID=

# --- IGDB (offline seed-generation script only, not used at runtime) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Bot protection (Cloudflare Turnstile) ---
# Optional but strongly recommended before launch: bot signup farms are the main vector
# for scams on matching apps. Leaving this blank disables the widget entirely and
# sign-up/sign-in work as before, so it's safe to defer.
# To enable: create a Turnstile site at https://dash.cloudflare.com (free), put the
# SITE key here, then paste the SECRET key into Supabase under
# Authentication -> Settings -> Bot and Abuse Protection -> Enable Captcha (Turnstile).
# Both sides must be set or Supabase rejects every token.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# --- Waitlist (duoqueue.io signup form) ---
#
#   WAITLIST_IP_SALT      NOT here, and not needed here. A Supabase FUNCTION secret only.
#                         32 random bytes, base64url:
#                         `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
#                         Set with `npx supabase secrets set WAITLIST_IP_SALT=...`.
#
#   RESEND_SEND_API_KEY   PRIMARILY a function secret, and optionally also here.
#                         `npx supabase secrets set RESEND_SEND_API_KEY=...` is what makes
#                         the public endpoint able to send its welcome email at all;
#                         until that is set, every signup is stored with
#                         welcome_status='deferred' and nothing goes out.
#                         Make a NEW Resend key with Sending access only, restricted to
#                         duoqueue.io. Do not reuse the key configured as Supabase Auth's
#                         custom SMTP password: that one is on the account-confirmation
#                         path and rotating this one must never be able to break signup.
#                         Put the SAME value below only if you need to run
#                         `node scripts/waitlist.mjs send-deferred --send`, which mails
#                         the rows the endpoint stored but could not send (budget-deferred
#                         rows, and everything taken while the function secret was unset).
#                         That script honours the same 80/day cap the endpoint does.
RESEND_SEND_API_KEY=
#
#   RESEND_ADMIN_API_KEY  local-only, for the Phase C launch-blast script. Contacts and
#                         broadcasts need more than send access, which is exactly why it
#                         is not the key the deployed function holds.
RESEND_ADMIN_API_KEY=

# --- Verified accounts: Steam (link-steam-callback Edge Function) ---
# Free, instant self-serve key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# Optional, defaults to "duoqueue" (matches app.json's "scheme").
APP_DEEP_LINK_SCHEME=

# --- Verified accounts: Riot / Xbox — NOT wired up yet. Riot requires a production
# API key from the Riot Developer Portal (manual approval); Xbox requires an Azure AD
# app + Xbox Live API access. Both need the project owner to register a developer
# account with that platform before a real linking flow can be built — see the
# "Linked Accounts" section in Settings, which shows them as "Coming soon" until then.
