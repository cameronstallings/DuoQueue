# --- Supabase (apps/mobile/.env, EXPO_PUBLIC_ prefix required for client-side vars) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase server-side (Edge Functions / scripts only, NEVER prefix with EXPO_PUBLIC_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# --- Sign in with Apple / Google (native auth) ---
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (Phase 4) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# --- Internal Edge Functions (Phase 5): shared secret for Postgres-trigger and
# scheduler calls to send-push-notification / daily-swipes-refreshed. Also goes into
# the `internal_trigger_token` row of the app_config table — see README setup step 5.
INTERNAL_TRIGGER_AUTH_TOKEN=

# --- Expo / EAS ---
EXPO_PUBLIC_APP_ENV=development
EAS_PROJECT_ID=

# --- IGDB (offline seed-generation script only, not used at runtime) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
