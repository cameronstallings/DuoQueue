{
  "name": "duoqueue",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "mobile": "pnpm --filter @duoqueue/mobile start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "seed:profiles": "tsx scripts/generate-fake-profiles.ts",
    "seed:build-sql": "tsx scripts/build-seed-sql.ts",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "video:install": "pnpm --dir marketing/video install --ignore-workspace",
    "video:studio": "pnpm --dir marketing/video studio",
    "video:day": "pnpm --dir marketing/video render-day",
    "video:audio": "pnpm --dir marketing/video audio",
    "video:verify": "pnpm --dir marketing/video verify"
  },
  "dependencies": {
    "@duoqueue/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^22",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
