# Copy to marketing/video/.env and edit. That file is gitignored; this one is committed.
# Read from the current working directory, which every script in package.json runs in.

# Which call to action the end card carries.
#   waitlist  the landing page. This is the default and is correct until DuoQueue 1.0 is released.
#   launched  the App Store, which requires APP_STORE_URL below.
# Anything else is a hard error, because a typo here would silently keep pointing finished
# videos at the waitlist after release.
PHASE=waitlist

# Only read when PHASE=launched, and then required. Must start with https://apps.apple.com/
# because that is the only thing an App Store link can be; render-day refuses to bundle
# otherwise. The id does not exist yet: the app is approved and not released, so this stays
# empty until Cameron presses Release and copies the link out of App Store Connect.
APP_STORE_URL=
