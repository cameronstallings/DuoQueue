{
  "expo": {
    "name": "DuoQueue",
    "slug": "duoqueue",
    "scheme": "duoqueue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14101F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.duoqueue.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DuoQueue needs access to your photos so you can add pictures to your profile.",
        "NSCameraUsageDescription": "DuoQueue needs access to your camera so you can take a new profile photo."
      }
    },
    "android": {
      "package": "com.duoqueue.app",
      "adaptiveIcon": {
        "backgroundColor": "#14101F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "DuoQueue needs access to your photos so you can add pictures to your profile.",
          "cameraPermission": "DuoQueue needs access to your camera so you can take a new profile photo."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#8452F5"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#14101F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14101F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DuoQueue needs access to your microphone to record a short voice intro for your profile."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
